  &quot;destinationStateId&quot;: &quot;11&quot;,&#xd;
  &quot;destinationCountryId&quot;: &quot;1&quot;,&#xd;
  &quot;myRole&quot;: &quot;Shipper&quot;,&#xd;
  &quot;rateShopTerms&quot;: &quot;Prepaid&quot;,&#xd;
  &quot;rateType&quot;: &quot;Regular&quot;,&#xd;
  &quot;products&quot;: [&#xd;
    {&#xd;
      &quot;productDescription&quot;: &quot;Dummy Freight Item&quot;,&#xd;
      &quot;units&quot;: 1,&#xd;
      &quot;unitTypeId&quot;: 32,&#xd;
      &quot;unitType&quot;: &quot;PALLET&quot;,&#xd;
      &quot;pieces&quot;: 1,&#xd;
      &quot;pieceTypeId&quot;: 18,&#xd;
      &quot;pieceType&quot;: &quot;CARTON&quot;,&#xd;
      &quot;length&quot;: 40,&#xd;
      &quot;width&quot;: 48,&#xd;
      &quot;height&quot;: 48,&#xd;
      &quot;class&quot;: &quot;50&quot;,&#xd;
      &quot;weight&quot;: 500,&#xd;
      &quot;hazardous&quot;: false&#xd;
    }&#xd;
  ],&#xd;
  &quot;additionalServices&quot;: [],&#xd;
  &quot;status&quot;: 1,&#xd;
  &quot;active&quot;: true&#xd;
}</stringProp>
